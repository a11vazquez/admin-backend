<h1>
    <%= title %>
</h1>

<form id="searchForm">
    <label for="searchProd">ID Producto :</label>
    <input type="number" name="id" id="searchProd" required value="<%= product ? product.id : '' %>">
    <button type="sumbit" class="input-btn">Modificar</button>
</form>

<section class="container">
<% if (product) { %>
        <form id="altaProducts-container" class="classic-form">
               
                <input type="hidden" name="id" class="input" value="<%= product.id %>">
                <label for="nameProd">Name</label>
                <input type="text" name="name" id="nameProd" class="input" value="<%= product.name %>" required>

                <label for="imageProd">Image</label>
                <input type="text" name="image" id="imageProd" class="input" value="<%= product.img %>" required>

                <label for="priceProd">Price</label>
                <input type="number" name="price" id="priceProd" class="input" value="<%= product.price %>" required>

                <label for="imageProd">Select Category :</label>
                <select name="category" id="categoryProd">
                    <option value="auriculares">Auriculares</option>
                    <option value="iphod's">Iphod</option>
                </select>

                <input type="submit" class="input-btn" value="Actualizar Producto">
            </form>
<% }  %>
</section>

<script type="module" src="/js/modify.js"></script>