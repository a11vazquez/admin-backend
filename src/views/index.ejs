
        <section class="hero">
            <div>
                <h1>Two Click!</h1>
                <p>Compra tu producto Apple en dos clicks</p>
                <h2>Agregá, señá y buscá.</h2>

            </div>
            <a href="#container"><button>View Products</button></a>
        </section>
        <h1 class="title"><%= about %></h1>
        <section id="container" class="container">
            <% products.forEach( p => { %> 
         <div class="card-product">
            <img src="<%= p.img %>" alt="<%= p.name %>"> 
            <p>ID : <%= p.id%></p>
                    <h3><%= p.name %></h3> 
                    <p>Category: <%= p.category %></p>
                    <p>Price: $ <%= p.price%></p>
                    <div class="card-buttons">
                        <button class="card-btn btn-modify" data-id="<%= p.id %>" data-btn-modify>Modificar</button>
                        <button class="card-btn btn-delete" data-id="<%= p.id %>" data-btn-delete>Eliminar</button>
                    </div>
                </div>
            <%})%>

        </section>

        <script src="/js/index.js"></script>