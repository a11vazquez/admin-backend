
        <section class="hero">
            <div class="hero-content">
                <h1>Two Click!</h1>
                <p>Panel De Administracion</p>
                <h2>Buscar, Crear, Eliminar, Modificar</h2>
                <a href="#container"><button>View Products</button></a>
            </div>
        </section>
        <h1 class="title"><%= about %></h1>
       
              <section class="category-products">
            <h3>Elige Tu Categoria</h3>
            <article class="filter-category-products">
                <button type="button" class="category-products_card" data-category="airpods">
                    <img src="img/card-airpods.png" alt="">
                    <a href="javascript:void(0)">AirPods</a>
                </button>

                <button type="button" class="category-products_card" data-category="iphone">
                    <img src="img/card-iphone.png" alt="">
                    <a href="javascript:void(0)">Iphone</a>
                </button>
                <button type="button" class="category-products_card" data-category="ipad">
                    <img src="img/card-ipad.png" alt="">
                    <a href="javascript:void(0)">Ipad</a>
                </button>

                <button type="button" class="category-products_card" data-category="mac">
                    <img src="img/card-mac.png" alt="">
                    <a href="javascript:void(0)">Mac</a>
                </button>

                <button  type="button" class="category-products_card" data-category="all">
                    <img src="img/card-all.png" alt="">
                   <a class="underline" href="javascript:void(0)">Todos</a>
                </button>

            </article>
            
        </section>
        <div class="container-orderBy">
            <div class="container-orderBy_btns">
                <button class="order-btn" id="sort-price-btn">Precio Mayor</button>
                <button class="order-btn" id="sort-price-lower-btn">Precio Menor</button>
                <button class="order-btn" id="sort-normal-btn">Normal</button>
            </div>
            
            <div class="section-search-product">
                <p>Buscar Producto :</p>
                <input 
                type="text" 
                id="filter-input"
                class="input-search-product" 
                placeholder="Escriba Aqui..">
                
            </div>
            
        </div>
        <section id="container" class="container">
        <% products.forEach( p => { %> 
         <div class="card-product">
            <div class="card-product_img">
                <img src="<%= p.img %>" alt="<%= p.name %>"> 
            </div>
            <p>ID : <%= p.id%></p>
                    <h3><%= p.name %></h3> 
                    <p>Category: <%= p.category %></p>
                    <p>Price: $ <%= p.price%></p>
                    <p>Stock: <%= p.stock%></p>
                    <div class="card-buttons">
                        <button class="card-btn btn-modify" data-id="<%= p.id %>" data-btn-modify>Modificar</button>
                        <button class="card-btn btn-delete" data-id="<%= p.id %>" data-btn-delete>Eliminar</button>
                    </div>
                </div>
            <%})%>

        </section>
    <script id="products-data" type="application/json">
        <%- JSON.stringify(products).replace(/</g, '\\u003c') %>
    </script>
        <script src="/js/index.js" ></script>